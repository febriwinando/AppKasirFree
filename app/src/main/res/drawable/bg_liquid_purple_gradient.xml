<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Canvas - Adapts dynamically to windowBackground theme -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/windowBackground" />
        </shape>
    </item>

    <!-- Liquid Glass Organic Subtle Overlay 1 (Light / Soft Dark Glow) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerX="20%"
                android:centerY="20%"
                android:endColor="@android:color/transparent"
                android:gradientRadius="700dp"
                android:startColor="#0D000000"
                android:type="radial" />
        </shape>
    </item>

    <!-- Liquid Glass Organic Subtle Overlay 2 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerX="80%"
                android:centerY="80%"
                android:endColor="@android:color/transparent"
                android:gradientRadius="600dp"
                android:startColor="#05FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>