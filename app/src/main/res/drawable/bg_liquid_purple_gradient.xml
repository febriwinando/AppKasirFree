<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Purple -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#311B92" />
        </shape>
    </item>

    <!-- Liquid Flow Highlight 1 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerX="30%"
                android:centerY="30%"
                android:endColor="@android:color/transparent"
                android:gradientRadius="600dp"
                android:startColor="#6A1B9A"
                android:type="radial" />
        </shape>
    </item>

    <!-- Liquid Flow Highlight 2 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerX="80%"
                android:centerY="80%"
                android:endColor="@android:color/transparent"
                android:gradientRadius="500dp"
                android:startColor="#5E35B1"
                android:type="radial" />
        </shape>
    </item>
</layer-list>