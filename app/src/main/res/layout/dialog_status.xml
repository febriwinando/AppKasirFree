<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconStatus"
            style="@style/Widget.App.Card"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#26FFFFFF">
            <ImageView
                android:id="@+id/imgStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_success"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Future.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Action Success"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/TextAppearance.Future.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your data has been successfully updated."
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.Future.LabelLarge"
            android:textColor="?attr/colorOnSurface"
            app:cornerRadius="20dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>