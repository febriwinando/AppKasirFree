<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Premium Immersive AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/dashboard_title"
            app:titleCentered="true"
            app:titleTextColor="@color/primary"
            app:titleTextAppearance="@style/TextAppearance.App.TitleLarge"
            android:background="@android:color/transparent"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="64dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Summary Plate -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Solid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:strokeWidth="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_person"
                            android:padding="14dp"
                            app:tint="@color/primary"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvNamaManager"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/root_operator"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvNamaRestoran"
                            style="@style/TextAppearance.App.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nexus_cluster"
                            android:textSize="14sp"
                            android:alpha="0.6" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnConfigMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:strokeWidth="0dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_more_vert"
                            app:tint="@color/primary"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status & Summary Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPesanan"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            style="@style/TextAppearance.App.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_orders"
                            android:alpha="0.5"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvJumlahPesanan"
                            style="@style/TextAppearance.App.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/value_zero"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProduk"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            style="@style/TextAppearance.App.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_menu_items"
                            android:alpha="0.5"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvJumlahProduk"
                            style="@style/TextAppearance.App.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/assets_0"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Branch Details Plate -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Solid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:id="@+id/tvNamaCabang"
                        style="@style/TextAppearance.App.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/primary_sector"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvAlamatCabang"
                        style="@style/TextAppearance.App.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:text="@string/quantum_status"
                        android:alpha="0.6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:text="@string/matrix_subsystems"
                android:textStyle="bold"
                android:textSize="18sp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginHorizontal="-6dp">

                <!-- Module: Kasir -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardKasir"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_transaction" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/tx_node" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Waiter -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWaiter"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_person" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/srv_network" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Stok -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStok"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_product" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/quantum_asset" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Dapur -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDapur"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_access_time" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/kitchen_grid" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Laporan -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLaporan"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_omzet" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/neural_report" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Pegawai -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPegawai"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_person" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/crew_sync" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Manage Menu -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardManageMenu"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_edit" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Manage Menu" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Module: Settings -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPengaturan"
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_app_logo" app:tint="@color/primary"/>
                        <TextView style="@style/TextAppearance.App.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="System Config" android:textStyle="bold" android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Logout Command -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.App.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:text="@string/terminate_link" />

            <!-- Hidden field for compatibility -->
            <TextView
                android:id="@+id/tvLoyaltyPoints"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>