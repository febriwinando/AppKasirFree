<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Future.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Verification"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/TextAppearance.Future.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Are you sure you want to proceed with this operation?"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Decline"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.Future.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Authorize"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.Future.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>