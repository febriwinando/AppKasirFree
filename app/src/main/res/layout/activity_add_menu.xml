<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Premium Executive AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:title="@string/catalog_entry_title"
            android:titleTextColor="@color/primary"
            android:titleTextAppearance="@style/TextAppearance.App.TitleLarge"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <!-- PAGE HEADER -->
            <TextView
                style="@style/TextAppearance.App.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_new_title" />

            <TextView
                style="@style/TextAppearance.App.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/menu_new_subtitle" />

            <!-- HERO IMAGE SELECTOR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImage"
                style="@style/Widget.App.Card.Solid"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="28dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgMenu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gambar menu"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:id="@+id/imgLogoOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface_variant"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_product"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            style="@style/TextAppearance.App.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Select Product Photo"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/TextAppearance.App.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="JPG, PNG, WEBP • Max 5MB" />

                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: CORE SPECS -->
            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/menu_identity" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMenuName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_sku">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSKU"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECTION: CLASSIFICATION -->
            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_classification" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_type"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/spinnerMenuType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_category"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECTION: PRICING -->
            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_pricing" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_cost"
                app:prefixText="Rp ">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCostPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_retail"
                app:prefixText="Rp ">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECTION: INVENTORY -->
            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_inventory" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_unit"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/spinnerUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_initial_qty">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECTION: STATUS -->
            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_status_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_status_active"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/spinnerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_availability"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/spinnerAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DESCRIPTION -->
            <TextView
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_desc" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/menu_desc">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ACTION -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.App.Button.Success"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:text="@string/menu_save"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>