<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        android:background="@color/background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary"
            app:title="Outlet Initiation"
            app:titleTextColor="@color/primary"
            app:titleTextAppearance="@style/TextAppearance.App.TitleLarge"
            android:background="@color/background" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.App.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operational Hub" />

            <TextView
                style="@style/TextAppearance.App.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Establish the primary operational node for your ecosystem." />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Solid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Branch Designation"
                        app:startIconDrawable="@drawable/ic_store"
                        app:startIconTint="@color/primary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNamaCabang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:padding="18dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Geographic Address"
                        app:startIconDrawable="@drawable/ic_edit"
                        app:startIconTint="@color/primary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtAlamatCabang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="2"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:padding="18dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Contact Protocol"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/primary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTeleponCabang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:padding="18dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Opening Sequence"
                        app:startIconDrawable="@drawable/ic_access_time"
                        app:startIconTint="@color/primary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtJamBuka"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:padding="18dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Closing Sequence"
                        app:startIconDrawable="@drawable/ic_access_time"
                        app:startIconTint="@color/primary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtJamTutup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:padding="18dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSimpan"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="32dp"
                        android:text="Commit Outlet" />

                    <!-- Hidden fields for compatibility -->
                    <View android:id="@+id/cardCabangUtama" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <View android:id="@+id/tvNamaRestoranHeader" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <View android:id="@+id/tvNamaOwnerHeader" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <View android:id="@+id/imgHeader" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <View android:id="@+id/tvHeaderTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <View android:id="@+id/tvHeaderSubtitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>