<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.KasirAPP" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Adaptive Luxury Soft Dark Theme -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#1E1E1E</item>
        <item name="colorPrimaryContainer">#2D2D2D</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="colorSecondary">#E0E0E0</item>
        <item name="colorOnSecondary">#1E1E1E</item>
        <item name="colorSecondaryContainer">#252525</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>

        <item name="android:windowBackground">#1E1E1E</item> <!-- Soft Dark/Black Canvas -->
        <item name="colorSurface">#252525</item> <!-- Soft Black Elevated Surface -->
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#2D2D2D</item>
        <item name="colorOnSurfaceVariant">#FFFFFF</item>
        <item name="colorOutline">#444444</item>
        <item name="colorOutlineVariant">#333333</item>

        <item name="android:statusBarColor">#1E1E1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1E1E1E</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Material 3 Precision Component Radii with Liquid Glass Defaults -->
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>

        <!-- Executive Minimalist Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Premium.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Premium.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Premium.BodyLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Premium.LabelLarge</item>
    </style>
</resources>